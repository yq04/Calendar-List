{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalendarList",
  "version": "0.1.1",
  "identifier": "com.kal.desktop.calendar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "日历清单 · Calendar List",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,TranslateUI --renderer-process-limit=2 --disable-background-networking --disable-sync --disable-extensions",
        "width": 1020,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "x": 90,
        "y": 80,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "focus": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
